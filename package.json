{
  "name": "nza-pv",
  "version": "0.1.0",
  "private": true,
  "description": "NZA-PV — 3D building & roof workbench for PV pre-feasibility",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm -F @nza-pv/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm -F @nza-pv/web preview",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -F @nza-pv/web test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=10"
  }
}
